{
    "name": "lionix/castable-request",
    "description": "Apply Eloquent attribute casts to Laravel form request input.",
    "keywords": [
        "laravel",
        "request",
        "form-request",
        "cast",
        "casts",
        "eloquent"
    ],
    "homepage": "https://github.com/lionix-team/castable-request",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "vaawebdev",
            "email": "vaawebdev@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Lionix\\CastableRequest\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lionix\\CastableRequest\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint --test",
        "format": "pint",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Lionix\\CastableRequest\\ServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
